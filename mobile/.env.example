# Base URL for the backend API, including the /api suffix. Expo inlines
# any EXPO_PUBLIC_* variable into the JS bundle at build time — same
# mechanism as VITE_API_BASE on the web portal.
#
# If you don't set this, the app defaults to:
#   - Android emulator: http://10.0.2.2:4000/api  (the emulator's alias for your host machine)
#   - iOS simulator:    http://localhost:4000/api  (simulator shares the host's network)
#   - Physical device:  neither of the above works — you MUST set this to
#     your dev machine's real LAN IP, e.g. http://192.168.1.42:4000/api
EXPO_PUBLIC_API_BASE=http://10.0.2.2:4000/api
