PORT=4000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgres://lessonteacher:CHANGE_ME@localhost:5432/lessonteacher

# Change these in production — never commit real secrets
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Payments — 'mock' works out of the box for development and testing.
# Switch to 'paystack' and add your secret key to go live.
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=

# File storage for lesson materials — 'local' works out of the box
# (saves to ./uploads, served at /uploads). Switch to 'cloudinary' and
# add your credentials for production.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Live video lessons (mediasoup SFU). ANNOUNCED_IP must be an address
# browsers can actually reach this server on directly — see
# RAILWAY.md / DEPLOYMENT.md for why this is the one part of this app
# that needs a host with real public UDP port control, which not every
# platform (including Railway) provides out of the box.
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100

# Notifications (booking updates, payment receipts, assignment updates).
# 'console' logs to stdout and records to the notifications table — works
# out of the box for development and testing, sends nothing real. Switch
# to 'smtp' / 'twilio' and add credentials to actually deliver email/SMS.
# Neither real provider has been tested against a live account from this
# codebase's own development environment — verify with real credentials
# before relying on them in production.
NOTIFICATION_EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

NOTIFICATION_SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional — Redis for caching (tutor search results) and, in future, a
# shared session store / job queue. The app runs fine without it: every
# Redis-backed feature degrades to a no-op when this is unset.
REDIS_URL=
TUTOR_LIST_CACHE_TTL_SECONDS=30

# Portal base URL, used to build links in emails (e.g. password reset).
PORTAL_URL=http://localhost:5173

# Comma-separated browser origins allowed by CORS (e.g. https://app.example.com).
# Unset allows all origins — set this in production.
CORS_ORIGINS=

# Per-IP auth endpoint cap per 15 min (default 30). Only raise for e2e/load tests.
AUTH_RATE_LIMIT_MAX=
