# Copy to deploy/.env and fill in. Never commit the real .env.

# ---- Server ---------------------------------------------------------------
DOMAIN=lessonteacher.example.com          # your domain (DNS A record -> this server)
PUBLIC_IP=203.0.113.10                    # this server's public IPv4 (used for video calls)
LETSENCRYPT_EMAIL=admin@example.com       # expiry notices from Let's Encrypt

# ---- Secrets (generate with: openssl rand -hex 32) ------------------------
POSTGRES_PASSWORD=change-me
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ---- Payments: Paystack, NGN ---------------------------------------------
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_live_xxx
# Webhook URL to set in the Paystack dashboard: https://<DOMAIN>/api/payments/webhook

# ---- Files: local disk by default (Docker volume "uploads") ---------------
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---- Email (SMTP) ---------------------------------------------------------
NOTIFICATION_EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lesson Teacher <no-reply@example.com>"

# ---- Push notifications (Firebase Cloud Messaging) ------------------------
NOTIFICATION_PUSH_PROVIDER=fcm
# Service account JSON on one line
FCM_SERVICE_ACCOUNT_JSON=

# ---- SMS (optional) --------------------------------------------------------
NOTIFICATION_SMS_PROVIDER=console
# NOTIFICATION_SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ---- Identity verification (Didit, optional) -------------------------------
# DIDIT_API_KEY=
# DIDIT_WORKFLOW_ID=
# DIDIT_WEBHOOK_SECRET=

# ---- Monitoring (optional) -------------------------------------------------
# SENTRY_DSN=
